# Arogo environment for a GCP e2-micro VM (systemd EnvironmentFile).
# Copy to  /home/arogo/arogo/arogo.env  and lock it down:  chmod 600 arogo.env
#
# NOTE: do NOT set SCHEDULER_ENABLED here — each systemd unit sets its own
# (web=0, scheduler=1). Setting it here would break that split.

# Required. Generate once with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# The web and scheduler units share this file, so they share this key.
SECRET_KEY=REPLACE_ME_WITH_A_64_CHAR_RANDOM_HEX

# Production hardening. COOKIE_SECURE=1 needs HTTPS — Caddy provides it
# automatically (see ../gcp/Caddyfile). Web Push + the service worker also
# require HTTPS.
FLASK_DEBUG=0
COOKIE_SECURE=1
CSP_ENABLED=1

# Your domain, matching the Caddyfile. Used in the links inside emails and
# push notifications.
APP_BASE_URL=https://arogo.yourdomain.com

# Required on this path: an e2-micro has 1GB RAM, so the database runs off-box
# on a free managed Postgres instead of local SQLite (Neon or Supabase both
# have a free tier — create a project there first, then paste its connection
# string here).
DATABASE_URL=postgresql://user:password@host:5432/arogo

# --- Optional integrations (unset = the feature logs instead of sending) ---

# Email (verification, password reset, weekly digest):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=you@gmail.com

# SMS / WhatsApp for zero-install caregiver alerts + the emergency SOS (Twilio):
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_SMS_FROM=+14155552671
# TWILIO_WHATSAPP_FROM=+14155552671

# Web Push: VAPID keys are auto-generated and stored on first run, so you can
# leave these unset. Set them only to pin a specific key across rebuilds.
# VAPID_PRIVATE_KEY=
# VAPID_CLAIMS_EMAIL=mailto:you@example.com
