# Copy to terraform.tfvars (gitignored — never commit the real file) and fill in.

project_id   = "your-gcp-project-id"
region       = "us-central1"   # must stay us-west1 / us-central1 / us-east1 for Always Free
zone         = "us-central1-a"
app_repo_url = "https://github.com/you/arogo.git"
domain       = "arogo.yourdomain.com"

# For a first test before you have a domain: set domain to the static IP
# (get it after one apply from the static_ip output) and use_https = false.
# Switch back once you have a real domain pointed at that IP.
# use_https = false

# python3 -c "import secrets; print(secrets.token_hex(32))"
secret_key = "REPLACE_ME"

# From your Neon or Supabase project's connection string
database_url = "postgresql://user:password@host:5432/arogo"

# Optional — leave all blank to skip SMTP (emails then just log server-side
# instead of sending). For Gmail: smtp_pass is an App Password from
# myaccount.google.com/apppasswords, not your real password (needs 2FA on).
# smtp_host = "smtp.gmail.com"
# smtp_port = "587"
# smtp_user = "you@gmail.com"
# smtp_pass = "REPLACE_ME"
# smtp_from = "you@gmail.com"
