# Arogo environment for a Raspberry Pi (systemd EnvironmentFile).
# Copy to  /home/pi/arogo/arogo.env  and lock it down:  chmod 600 arogo.env
#
# NOTE: do NOT set SCHEDULER_ENABLED here — each systemd unit sets its own
# (web=0, scheduler=1). Setting it here would break that split.

# Required. Generate once with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# The web and scheduler units share this file, so they share this key.
SECRET_KEY=REPLACE_ME_WITH_A_64_CHAR_RANDOM_HEX

# Production hardening. COOKIE_SECURE=1 needs HTTPS — Tailscale Serve provides
# it (see DEPLOY.md). Web Push + the service worker also require HTTPS.
FLASK_DEBUG=0
COOKIE_SECURE=1
CSP_ENABLED=1

# Your Pi's HTTPS URL from Tailscale (`tailscale serve status`). Used in the
# links inside emails and push notifications.
APP_BASE_URL=https://arogo.your-tailnet.ts.net

# Database: leave DATABASE_URL unset to use SQLite (medeasy.db in the app dir) —
# the right choice for a single-user home Pi. Set it only for PostgreSQL.
# DATABASE_URL=postgresql://arogo:password@localhost:5432/arogo

# --- Optional integrations (unset = the feature logs instead of sending) ---

# Email (verification, password reset, weekly digest):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=you@gmail.com

# SMS / WhatsApp for zero-install caregiver alerts + the emergency SOS (Twilio):
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_SMS_FROM=+14155552671
# TWILIO_WHATSAPP_FROM=+14155552671

# Web Push: VAPID keys are auto-generated and stored on first run, so you can
# leave these unset. Set them only to pin a specific key across rebuilds.
# VAPID_PRIVATE_KEY=
# VAPID_CLAIMS_EMAIL=mailto:you@example.com
