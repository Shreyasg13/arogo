#!/bin/sh
# MedEasy pre-commit hook — full check in ~10s.
# Enable once per clone:  git config core.hooksPath .githooks
# Skip in an emergency:   git commit --no-verify

set -e

echo "[pre-commit] Python test suite..."
# Parallel across CPU cores; loadfile keeps each test file (and its module-scoped
# fixtures / ordering) on a single worker. Falls back to serial if xdist is absent.
python -m pytest tests/ -q -n auto --dist loadfile 2>/dev/null || python -m pytest tests/ -q

echo "[pre-commit] JS syntax..."
node --check static/js/app.js
node --check static/sw.js

echo "[pre-commit] JS unit tests..."
node tests/js/run_js_tests.mjs
node tests/js/run_sw_tests.mjs

echo "[pre-commit] All checks passed."
