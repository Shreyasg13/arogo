# ── Database ──────────────────────────────────────────────────────────────────
# Leave blank to use SQLite (dev). Set for PostgreSQL:
DATABASE_URL=postgresql://mediscan:yourpassword@localhost:5432/mediscan

# ── Flask ─────────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-secret-string

# ── Strava ────────────────────────────────────────────────────────────────────
# 1. Go to https://www.strava.com/settings/api
# 2. Create an app, set redirect to: http://localhost:5000/oauth/strava/callback
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret
STRAVA_REDIRECT_URI=http://localhost:5000/oauth/strava/callback

# ── Garmin ────────────────────────────────────────────────────────────────────
# 1. Apply at https://developer.garmin.com/gc-developer-program/overview/
# 2. Uses OAuth 1.0a (consumer key/secret)
GARMIN_CONSUMER_KEY=your_garmin_consumer_key
GARMIN_CONSUMER_SECRET=your_garmin_consumer_secret
GARMIN_REDIRECT_URI=http://localhost:5000/oauth/garmin/callback

# ── Google Fit ────────────────────────────────────────────────────────────────
# 1. console.cloud.google.com → New project → Enable "Fitness API"
# 2. APIs & Services → Credentials → OAuth 2.0 Client → Web app
# 3. Authorized redirect: http://localhost:5000/oauth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/oauth/google/callback

# ── Apple Health ──────────────────────────────────────────────────────────────
# No API keys needed. User exports from iPhone and uploads the ZIP.
# See the Apple Health import button in the Fitness section.
